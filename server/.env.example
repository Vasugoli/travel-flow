# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or Atlas URI)
# Local Example: mongodb://localhost:27017/transport_module
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/travelDB?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/transport_module

# JSON Web Token Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
